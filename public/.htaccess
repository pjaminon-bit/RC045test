RewriteEngine On
DirectoryIndex index.php

# #226: een later fysiek toegevoegd PHP-bestand mag nooit door alleen zijn
# filesystemplaatsing rechtstreeks leesbaar/uitvoerbaar worden. Alleen de
# exacte lower-case frontcontroller public/index.php is de fysieke uitzondering.
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_FILENAME} !/index\.php$
RewriteRule \.php$ - [F,L,NC]

# Alleen reguliere bestanden in deze minimale public/ root worden direct door
# Apache geserveerd. Alle overige URL's lopen door de positieve router.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteRule ^Over-ons/?$ /index.html#over-ons [R=301,L,NC,NE]
RewriteRule ^Lidmaatschap/?$ /#lidmaatschap [R=301,L,NC,NE]
RewriteRule ^ index.php [L,QSA]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>
