RewriteEngine On
Options -Indexes -MultiViews
DirectoryIndex index.php

# #226: alleen reguliere bestanden in deze minimale public/ root worden direct
# door Apache geserveerd. Alle overige URL's lopen door de positieve router.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteRule ^Over-ons/?$ /index.html#over-ons [R=301,L,NC,NE]
RewriteRule ^Lidmaatschap/?$ /#lidmaatschap [R=301,L,NC,NE]
RewriteRule ^ index.php [L,QSA]

# Defense in depth voor standalone Apache: een later toegevoegd PHP-bestand
# mag nooit door alleen zijn filesystemplaatsing uitvoerbaar of leesbaar worden.
<FilesMatch "\.php$">
  Require all denied
</FilesMatch>
<Files "index.php">
  Require all granted
</Files>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>
