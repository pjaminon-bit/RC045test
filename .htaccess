RewriteEngine On

# ============================================================
# Verenigingsplatform .htaccess
# ============================================================

Options -Indexes

# ===== HTTPS / canonical host =====
# De gedeelde applicatielaag redirect bewust NIET op basis van HTTP_HOST.
# Een Host-header is clientinvoer en mag nooit als redirectdoel worden
# teruggespiegeld. Huidige standalone/DEV-hosting handelt HTTP -> HTTPS vóór
# deze applicatielaag af. Op de multi-tenant VPS zijn TLS, canonical-host en
# onbekende-hostafwijzing een harde vhost/reverse-proxyverantwoordelijkheid.
# Zie docs/VPS-DEPLOYMENT.md en deployment.json.web.

# ===== Algemene security headers =====
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

DirectoryIndex index.php index.html

# ===== Tenant-aware publieke JSON =====
# Dynamische openbare content staat voor externe tenants buiten de documentroot.
# Ook legacy /data/*.json-verzoeken lopen daarom via één whitelisted PHP-endpoint.
# De bestaande standalone RC045-installatie blijft via datzelfde endpoint de
# bestanden uit /data lezen.
RewriteRule ^data/(homepage|ontstaan|baanreglement|aanmelden|bedankt|actueel|agenda|faq|sponsors|contact|nieuws|media|media-pagina|fotoboek|fotoboek-pagina|rekentabel|lidmaatschapstypen|changelog)\.json$ public-content.php?key=$1 [L,QSA]

# ===== Publieke beeldassets =====
# DEV is een code-/templateacceptatieomgeving en bevat bewust niet alle
# tenantuploads of historische RC045-foto's. Tenant-specifieke sponsoritems
# worden daarom al in public-content.php uit de DEV-response gefilterd; de
# browser vraagt die ontbrekende upload-URL's dus niet aan. Directe requests
# naar ontbrekende sponsoruploads blijven via de generieke assetgateway
# fail-closed. Overige ontbrekende DEV-beelden krijgen lokaal de neutrale
# SVG-placeholder.
RewriteCond %{REQUEST_URI} ^/dev/images/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^images/(?!sponsors/)(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9][A-Za-z0-9._-]{0,180}\.(?:jpe?g|png|webp|gif|svg)$ images/template-placeholder.svg [L,NC]

# Buiten DEV krijgt een nog niet ingestelde algemene templatefoto eveneens een
# lokale placeholder. Sponsor- en fotoboekpaden zijn tenantuploads en vallen
# bewust NIET onder deze fallback: hun metadata en bestand moeten bij elkaar
# horen en fouten daarin moeten zichtbaar blijven.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^images/(?!sponsors/|fotoboek/)(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9][A-Za-z0-9._-]{0,180}\.(?:jpe?g|png|webp|gif|svg)$ images/template-placeholder.svg [L,NC]

# ===== Tenant-aware publieke uploads =====
# Externe tenants bewaren uploads buiten de documentroot. De bestaande URL's
# blijven gelijk, maar alleen strikt gevalideerde fotoboekbestanden en
# sponsorlogo's kunnen via de read-only assetgateway worden gelezen.
RewriteRule ^images/sponsors/([A-Za-z0-9][A-Za-z0-9._-]{0,180})$ public-asset.php?scope=sponsors&path=$1 [L,QSA,NE]
RewriteRule ^images/fotoboek/([a-z0-9][a-z0-9-]*)/(thumbs/)?([A-Za-z0-9][A-Za-z0-9._-]{0,180})$ public-asset.php?scope=fotoboek&path=$1/$2$3 [L,QSA,NE]

# ===== Fotoboek: nette album-URL's =====
RewriteRule ^fotoboek/?$ fotoboek.php [L,QSA]
RewriteRule ^fotoboek/([a-z0-9][a-z0-9-]*)/?$ fotoboek.php?album=$1 [L,QSA,NC]

# ===== Publieke pagina's draaien op PHP, URL's blijven .html =====
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)\.html$ $1.php [L]

# ============================================================
# SERVER-ONLY BESTANDEN EN ONTWIKKELTOOLING
# ============================================================
RewriteRule ^beheer-(config\.php|users\.json|log\.json|login-pogingen\.json)$ - [F,L]
RewriteRule ^(?:app|bin|tests|docs|\.github|\.git)(?:/|$) - [F,L,NC]
RewriteRule ^leden-app\.php$ - [F,L,NC]
RewriteRule ^data-backups(?:/|$) - [F,L,NC]
RewriteRule ^beheer/(?:backup-registry\.php|gebruikers-rechten\.php|fotoboek-lib\.php)$ - [F,L,NC]
RewriteRule ^beheer/(?:bootstrap\.php|module-registry\.php|modules(?:/|$)) - [F,L,NC]

# Private domeindata. De PHP-voorloop in deze bestanden is een tweede laag;
# Apache weigert ze al voordat PHP de inhoud kan uitvoeren.
<FilesMatch "^(leden-data\.php|aanmeldingen-data\.php|contactberichten-data\.php|contributies-data\.php|groepen-data\.php|ledenlabels-data\.php|leden-opslag\.php|aanmeldingen-opslag\.php|contactberichten-opslag\.php|groepen-opslag\.php|ledenlabels-opslag\.php|aanmelden-pogingen\.php|vergaderingen-data\.php|vergaderingen-opslag\.php|taken-data\.php|taken-opslag\.php|operationele-taken-data\.php|operationele-taken-opslag\.php|evenementen-data\.php|evenementen-opslag\.php)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(auth\.php|data-slot\.php|vertaal-config\.php|site-config(?:\.local)?\.php|site\.php|site-seo\.php|paneel-modules\.php|module-definities\.php|changelog-historie\.php|dev-build\.json)$">
  Require all denied
</FilesMatch>

# ============================================================
# VRIENDELIJKE URL'S
# ============================================================
RewriteRule ^Over-ons/?$ /index.html#over-ons [R=301,L,NC,NE]
RewriteRule ^Lidmaatschap/?$ /#lidmaatschap [R=301,L,NC,NE]
