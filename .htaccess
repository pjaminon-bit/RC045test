RewriteEngine On

# ============================================================
# RC045 .htaccess
# ============================================================

Options -Indexes

# ===== HTTPS afdwingen =====
RewriteCond %{HTTPS} =on [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} =https [OR]
RewriteCond %{HTTP:X-Forwarded-SSL} =on
RewriteRule ^ - [E=RC045_HTTPS:1]
RewriteCond %{ENV:RC045_HTTPS} !=1
RewriteCond %{SERVER_PORT} !=443
RewriteRule ^ https://rc045.nl%{REQUEST_URI} [R=301,L]

# ===== Algemene security headers =====
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

DirectoryIndex index.php index.html

# ===== Fotoboek: nette album-URL's =====
RewriteRule ^fotoboek/?$ fotoboek.php [L,QSA]
RewriteRule ^fotoboek/([a-z0-9][a-z0-9-]*)/?$ fotoboek.php?album=$1 [L,QSA,NC]

# ===== Publieke pagina's draaien op PHP, URL's blijven .html =====
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)\.html$ $1.php [L]

# ============================================================
# SERVER-ONLY BESTANDEN
# ============================================================
RewriteRule ^beheer-(config\.php|users\.json|log\.json|login-pogingen\.json)$ - [F,L]
RewriteRule ^app(?:/|$) - [F,L,NC]
RewriteRule ^leden-app\.php$ - [F,L,NC]
RewriteRule ^data-backups(?:/|$) - [F,L,NC]

# Helperbestanden onder /beheer zijn alleen bedoeld voor server-side require.
RewriteRule ^beheer/(?:backup-registry\.php|gebruikers-rechten\.php|fotoboek-lib\.php)$ - [F,L,NC]

# Oude, niet-canonieke beheer-bootstrap/modulekopieën kunnen door de additieve
# SFTP-deployment nog op de server staan.
RewriteRule ^beheer/(?:bootstrap\.php|module-registry\.php|modules(?:/|$)) - [F,L,NC]

# Private domeindata. De PHP-voorloop in deze bestanden is een tweede laag;
# Apache weigert ze al voordat PHP de inhoud kan uitvoeren.
<FilesMatch "^(leden-data\.php|aanmeldingen-data\.php|leden-opslag\.php|aanmeldingen-opslag\.php|aanmelden-pogingen\.php|vergaderingen-data\.php|vergaderingen-opslag\.php|taken-data\.php|taken-opslag\.php|operationele-taken-data\.php|operationele-taken-opslag\.php|evenementen-data\.php|evenementen-opslag\.php)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(auth\.php|data-slot\.php|vertaal-config\.php|site-config(?:\.local)?\.php|site\.php|site-seo\.php|paneel-modules\.php|module-definities\.php|changelog-historie\.php|dev-build\.json)$">
  Require all denied
</FilesMatch>

# ============================================================
# VRIENDELIJKE URL'S
# ============================================================
RewriteRule ^Over-ons/?$ /index.html#over-ons [R=301,L,NC,NE]
RewriteRule ^Lidmaatschap/?$ /#lidmaatschap [R=301,L,NC,NE]
