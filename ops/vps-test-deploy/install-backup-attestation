#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  echo "FOUT: install-backup-attestation moet als root worden uitgevoerd." >&2
  exit 1
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
SOURCE_ATTESTOR="${SCRIPT_DIR}/verenigingsplatform-backup-attestor"
TARGET_DIR="/usr/local/libexec/verenigingsplatform"
TARGET_ATTESTOR="${TARGET_DIR}/backup-attestor"
KEY_DIR="/etc/verenigingsplatform/backup-attestation"
PRIVATE_KEY="${KEY_DIR}/private.pem"
PUBLIC_KEY="${KEY_DIR}/public.pem"
UNIT="/etc/systemd/system/verenigingsplatform-backup-attestor.service"
RUNTIME_DIR="/run/verenigingsplatform"
PYTHON="/usr/bin/python3"

check_source() {
  [[ -f "${SOURCE_ATTESTOR}" && ! -L "${SOURCE_ATTESTOR}" ]] || {
    echo "FOUT: canonieke backup-attestor ontbreekt of is een symlink." >&2
    exit 1
  }
  "${PYTHON}" -c 'import pathlib,sys; p=pathlib.Path(sys.argv[1]); compile(p.read_text(encoding="utf-8"), str(p), "exec")' "${SOURCE_ATTESTOR}"
}

# Bestaande VPS-installaties kunnen een historische root-owned
# private/backups/tenant-boom hebben. Dat wijkt af van het runtimecontract:
# private_root en alle runtime-data daaronder horen aan de unieke tenant-UID/GID.
#
# De migratie is bewust beperkt tot exact deze backupnamespace. Alleen een
# geldige root-owned deployment.json bepaalt private_root en tenantaccount.
# Gezonde tenant-owned bomen worden uitsluitend gevalideerd. Een legacy
# root-owned boom wordt eerst volledig gecontroleerd terwijl de tenant hem nog
# niet kan betreden; kinderen worden daarna deepest-first hersteld en de
# namespace-root pas als laatste. Symlinks, special files, hardlinks,
# onverwachte owners of group/world-writeable metadata stoppen fail-closed.
backup_namespace_contract() {
  local mode="${1:-}"
  [[ "${mode}" == 'check' || "${mode}" == 'repair' ]] || {
    echo 'FOUT: ongeldige backup-ownershipmodus.' >&2
    exit 1
  }

  "${PYTHON}" - "${mode}" <<'PY'
import json
import os
import pwd
import stat
import sys
from pathlib import Path

MODE = sys.argv[1]
TENANT_BASE = Path('/srv/verenigingen')
DIR_MODE = 0o750
FILE_MODE = 0o640


def die(message: str) -> None:
    print(f'FOUT: backupnamespace ownership: {message}', file=sys.stderr)
    raise SystemExit(1)


def no_symlink_components(path: Path) -> bool:
    try:
        current = Path(path.anchor or '/')
        for part in path.parts[1:]:
            current = current / part
            st = os.lstat(current)
            if stat.S_ISLNK(st.st_mode):
                return False
        return True
    except OSError:
        return False


def regular_root_deployment(path: Path) -> bool:
    try:
        st = os.lstat(path)
    except OSError:
        return False
    return (
        stat.S_ISREG(st.st_mode)
        and not stat.S_ISLNK(st.st_mode)
        and st.st_uid == 0
        and (st.st_mode & 0o022) == 0
        and no_symlink_components(path)
    )


def metadata(path: Path):
    try:
        return os.lstat(path)
    except OSError as exc:
        die(f'metadata onleesbaar voor {path}: {exc}')


def validate_runtime_parent(path: Path, uid: int, gid: int, label: str) -> None:
    st = metadata(path)
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        die(f'{label} is geen veilige directory: {path}')
    if st.st_uid != uid or st.st_gid != gid or stat.S_IMODE(st.st_mode) != DIR_MODE:
        die(f'{label} wijkt af van tenant-owned 0750: {path}')


def tree_snapshot(root: Path, uid: int, gid: int, allow_root_owner: bool):
    entries = []
    try:
        walker = os.walk(root, topdown=True, followlinks=False)
        for current, dirs, files in walker:
            current_path = Path(current)
            for name in dirs + files:
                path = current_path / name
                st = metadata(path)
                if stat.S_ISLNK(st.st_mode):
                    die(f'symlink geweigerd: {path}')
                is_dir = stat.S_ISDIR(st.st_mode)
                is_file = stat.S_ISREG(st.st_mode)
                if not is_dir and not is_file:
                    die(f'special filesystemobject geweigerd: {path}')
                if is_file and st.st_nlink != 1:
                    die(f'hardlink geweigerd: {path}')
                owner = (st.st_uid, st.st_gid)
                allowed = {(uid, gid)}
                if allow_root_owner:
                    allowed.add((0, 0))
                if owner not in allowed:
                    die(f'onverwachte owner geweigerd: {path}')
                if (st.st_mode & 0o022) != 0:
                    die(f'group/world-writeable object geweigerd: {path}')
                entries.append((path, st.st_dev, st.st_ino, is_dir))
    except OSError as exc:
        die(f'backupboom kon niet veilig worden geïnventariseerd: {exc}')
    return entries


def apply_snapshot(path: Path, dev: int, ino: int, is_dir: bool, uid: int, gid: int) -> None:
    flags = os.O_RDONLY | getattr(os, 'O_CLOEXEC', 0) | getattr(os, 'O_NOFOLLOW', 0)
    if is_dir:
        flags |= getattr(os, 'O_DIRECTORY', 0)
    try:
        fd = os.open(path, flags)
    except OSError as exc:
        die(f'object kon niet veilig worden geopend voor ownershipmigratie: {path}: {exc}')
    try:
        st = os.fstat(fd)
        if st.st_dev != dev or st.st_ino != ino:
            die(f'object wijzigde tijdens ownershipmigratie: {path}')
        if is_dir != stat.S_ISDIR(st.st_mode):
            die(f'objecttype wijzigde tijdens ownershipmigratie: {path}')
        if not is_dir and not stat.S_ISREG(st.st_mode):
            die(f'bestandstype wijzigde tijdens ownershipmigratie: {path}')
        os.fchown(fd, uid, gid)
        os.fchmod(fd, DIR_MODE if is_dir else FILE_MODE)
    finally:
        os.close(fd)


def validate_healthy_tree(root: Path, uid: int, gid: int) -> None:
    root_st = metadata(root)
    if (
        not stat.S_ISDIR(root_st.st_mode)
        or stat.S_ISLNK(root_st.st_mode)
        or root_st.st_uid != uid
        or root_st.st_gid != gid
        or stat.S_IMODE(root_st.st_mode) != DIR_MODE
    ):
        die(f'backupnamespace-root wijkt af van tenant-owned 0750: {root}')
    for path, _dev, _ino, is_dir in tree_snapshot(root, uid, gid, False):
        st = metadata(path)
        expected_mode = DIR_MODE if is_dir else FILE_MODE
        if st.st_uid != uid or st.st_gid != gid or stat.S_IMODE(st.st_mode) != expected_mode:
            die(f'backupnamespace-object wijkt af van tenantcontract: {path}')


if not TENANT_BASE.is_dir() or TENANT_BASE.is_symlink():
    die(f'tenantbasis ontbreekt of is onveilig: {TENANT_BASE}')

checked = 0
repaired = 0

try:
    tenant_dirs = sorted(TENANT_BASE.iterdir(), key=lambda p: p.name)
except OSError as exc:
    die(f'tenantbasis kon niet worden gelezen: {exc}')

for tenant_dir in tenant_dirs:
    if tenant_dir.is_symlink():
        die(f'symlink als tenantdirectory geweigerd: {tenant_dir}')
    if not tenant_dir.is_dir():
        continue

    deployment_file = tenant_dir / 'deployment.json'
    if not deployment_file.exists():
        continue
    if not regular_root_deployment(deployment_file):
        # De attestor accepteert deze deployment zelf evenmin; raak zijn data
        # dus niet aan vanuit een ownershipmigratie.
        continue

    try:
        doc = json.loads(deployment_file.read_text(encoding='utf-8'))
    except (OSError, UnicodeError, ValueError):
        continue
    if not isinstance(doc, dict) or int(doc.get('schema', 0)) != 1:
        continue
    tenant = doc.get('tenant')
    fpm = doc.get('php_fpm')
    if not isinstance(tenant, dict) or not isinstance(fpm, dict):
        continue
    tenant_root_raw = tenant.get('tenant_root')
    private_root_raw = tenant.get('private_root')
    os_user = fpm.get('recommended_os_user')
    if not all(isinstance(v, str) and v.startswith('/') for v in (tenant_root_raw, private_root_raw)):
        continue
    if not isinstance(os_user, str) or not os_user:
        continue

    try:
        account = pwd.getpwnam(os_user)
    except KeyError:
        continue
    uid = account.pw_uid
    gid = account.pw_gid
    if uid <= 0 or gid <= 0:
        continue

    tenant_root = Path(tenant_root_raw)
    private_root = Path(private_root_raw)
    try:
        if tenant_root.resolve(strict=True) != tenant_dir.resolve(strict=True):
            continue
        if private_root.resolve(strict=True) != (tenant_root / 'private').resolve(strict=True):
            continue
    except OSError:
        continue
    if tenant_root.is_symlink() or private_root.is_symlink() or not no_symlink_components(private_root):
        continue

    backups_root = private_root / 'backups'
    backup_root = backups_root / 'tenant'
    if not backup_root.exists():
        continue

    validate_runtime_parent(private_root, uid, gid, 'private_root')
    validate_runtime_parent(backups_root, uid, gid, 'backups-root')

    root_st = metadata(backup_root)
    if not stat.S_ISDIR(root_st.st_mode) or stat.S_ISLNK(root_st.st_mode) or not no_symlink_components(backup_root):
        die(f'backupnamespace-root is onveilig: {backup_root}')

    checked += 1
    owner = (root_st.st_uid, root_st.st_gid)
    expected_owner = (uid, gid)

    if owner == expected_owner:
        validate_healthy_tree(backup_root, uid, gid)
        continue

    if MODE == 'check':
        die(f'legacy ownershipdrift vereist migratie: {backup_root}')
    if owner != (0, 0):
        die(f'onverwachte backupnamespace-owner geweigerd: {backup_root}')
    if (root_st.st_mode & 0o022) != 0:
        die(f'group/world-writeable backupnamespace geweigerd: {backup_root}')

    root_identity = (root_st.st_dev, root_st.st_ino)
    entries = tree_snapshot(backup_root, uid, gid, True)
    entries.sort(key=lambda item: len(item[0].parts), reverse=True)

    # De root blijft root-owned en niet tenant-traverseerbaar terwijl alle
    # kinderen worden hersteld. Daardoor kan de tenant geen half-gemigreerde
    # boom wijzigen. De root zelf wordt bewust als laatste vrijgegeven.
    for path, dev, ino, is_dir in entries:
        apply_snapshot(path, dev, ino, is_dir, uid, gid)

    apply_snapshot(backup_root, root_identity[0], root_identity[1], True, uid, gid)
    validate_healthy_tree(backup_root, uid, gid)
    repaired += 1

print(f'backup_namespace_checked={checked}')
print(f'backup_namespace_repaired={repaired}')
PY
}

check_keys() {
  [[ -d "${KEY_DIR}" && ! -L "${KEY_DIR}" ]] || return 1
  [[ "$(stat -c '%u:%g:%a' "${KEY_DIR}")" == "0:0:711" ]] || return 1
  [[ -f "${PRIVATE_KEY}" && ! -L "${PRIVATE_KEY}" && -f "${PUBLIC_KEY}" && ! -L "${PUBLIC_KEY}" ]] || return 1
  [[ "$(stat -c '%u:%g:%a' "${PRIVATE_KEY}")" == "0:0:600" ]] || return 1
  [[ "$(stat -c '%u:%g:%a' "${PUBLIC_KEY}")" == "0:0:644" ]] || return 1
  local tmp
  tmp="$(mktemp)"
  trap 'rm -f "${tmp:-}"' RETURN
  /usr/bin/openssl pkey -in "${PRIVATE_KEY}" -pubout -out "${tmp}" >/dev/null 2>&1
  cmp -s "${tmp}" "${PUBLIC_KEY}"
}

check_install() {
  check_source
  [[ -f "${TARGET_ATTESTOR}" && ! -L "${TARGET_ATTESTOR}" ]] || {
    echo "FOUT: geïnstalleerde backup-attestor ontbreekt." >&2
    exit 1
  }
  [[ "$(stat -c '%u:%g:%a' "${TARGET_ATTESTOR}")" == "0:0:555" ]] || {
    echo "FOUT: backup-attestor metadata wijkt af." >&2
    exit 1
  }
  cmp -s "${SOURCE_ATTESTOR}" "${TARGET_ATTESTOR}" || {
    echo "FOUT: geïnstalleerde backup-attestor wijkt af van de canonieke bron." >&2
    exit 1
  }
  check_keys || {
    echo "FOUT: backup-attestation keydirectory/keypair ontbreekt, wijkt af of heeft onveilige metadata." >&2
    exit 1
  }
  [[ -f "${UNIT}" && ! -L "${UNIT}" && "$(stat -c '%u:%g:%a' "${UNIT}")" == "0:0:644" ]] || {
    echo "FOUT: systemd-unit ontbreekt of heeft onveilige metadata." >&2
    exit 1
  }
  systemctl is-enabled verenigingsplatform-backup-attestor.service >/dev/null
  systemctl is-active verenigingsplatform-backup-attestor.service >/dev/null
  [[ -S "${RUNTIME_DIR}/backup-attestor.sock" && ! -L "${RUNTIME_DIR}/backup-attestor.sock" ]] || {
    echo "FOUT: backup-attestor socket is niet actief." >&2
    exit 1
  }
  backup_namespace_contract check
  echo "OK: backup-attestation actief"
  echo "attestor_sha256=$(sha256sum "${TARGET_ATTESTOR}" | awk '{print $1}')"
  echo "public_key_sha256=$(sha256sum "${PUBLIC_KEY}" | awk '{print $1}')"
}

if [[ "${1:-}" == "--check" ]]; then
  check_install
  exit 0
fi
if [[ $# -ne 0 ]]; then
  echo "Gebruik: $0 [--check]" >&2
  exit 2
fi

check_source
install -d -o root -g root -m 0755 "${TARGET_DIR}"
# De directory is bewust alleen traverseerbaar voor niet-root. Daardoor kan de
# tenant-runtime het vaste public.pem-pad lezen zonder de directory te kunnen
# listen, terwijl private.pem door root:root 0600 onleesbaar blijft.
install -d -o root -g root -m 0711 "${KEY_DIR}"

if [[ -e "${PRIVATE_KEY}" || -e "${PUBLIC_KEY}" ]]; then
  check_keys || {
    echo "FOUT: bestaand backup-attestation keypair is onvolledig of onveilig; niet automatisch roteren." >&2
    exit 1
  }
else
  umask 077
  private_tmp="$(mktemp "${KEY_DIR}/private.pem.tmp.XXXXXX")"
  public_tmp="$(mktemp "${KEY_DIR}/public.pem.tmp.XXXXXX")"
  cleanup_key_tmp() { rm -f "${private_tmp:-}" "${public_tmp:-}"; }
  trap cleanup_key_tmp EXIT
  /usr/bin/openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out "${private_tmp}" >/dev/null 2>&1
  /usr/bin/openssl pkey -in "${private_tmp}" -pubout -out "${public_tmp}" >/dev/null 2>&1
  install -o root -g root -m 0600 "${private_tmp}" "${PRIVATE_KEY}"
  install -o root -g root -m 0644 "${public_tmp}" "${PUBLIC_KEY}"
  cleanup_key_tmp
  trap - EXIT
fi

# Herstel uitsluitend de historische backupnamespace-drift. De tenant-FPM-user
# kan een root-owned 0750 namespace niet betreden, waardoor deze migratie vóór
# het vrijgeven van de root zonder runtime-writer-race kan plaatsvinden.
backup_namespace_contract repair

install -o root -g root -m 0555 "${SOURCE_ATTESTOR}" "${TARGET_ATTESTOR}"

unit_tmp="$(mktemp)"
cleanup_unit_tmp() { rm -f "${unit_tmp:-}"; }
trap cleanup_unit_tmp EXIT
cat >"${unit_tmp}" <<'UNITEOF'
[Unit]
Description=Verenigingsplatform tenant backup attestor
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/verenigingsplatform/backup-attestor
Restart=on-failure
RestartSec=2s
RuntimeDirectory=verenigingsplatform
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/srv/verenigingen
ReadWritePaths=/run/verenigingsplatform

[Install]
WantedBy=multi-user.target
UNITEOF
install -o root -g root -m 0644 "${unit_tmp}" "${UNIT}"
cleanup_unit_tmp
trap - EXIT

systemctl daemon-reload
systemctl enable --now verenigingsplatform-backup-attestor.service

check_install
