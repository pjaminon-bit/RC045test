#!/usr/bin/bash
set -euo pipefail
export PATH='/usr/sbin:/usr/bin:/sbin:/bin'

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo 'Deze deploywrapper moet als root draaien.' >&2
  exit 77
fi
if [[ "$#" -ne 1 || ! "$1" =~ ^[0-9a-f]{40}$ ]]; then
  echo 'Gebruik: verenigingsplatform-github-deploy <40-hex-commit>' >&2
  exit 64
fi

commit="$1"
repo='https://github.com/pjaminon-bit/RC045test.git'
platform_root='/srv/verenigingsplatform'
tenant_base='/srv/verenigingen'
staging_base='/var/lib/verenigingsplatform/github-staging'
control_plane_config='/etc/verenigingsplatform/control-plane/runtime.json'
host_launcher='/usr/local/sbin/verenigingsplatform-host-php'
php='/usr/bin/php8.5'
git='/usr/bin/git'
install='/usr/bin/install'
mktemp='/usr/bin/mktemp'
rm='/usr/bin/rm'
readlink_bin='/usr/bin/readlink'
grep_bin='/usr/bin/grep'
stat_bin='/usr/bin/stat'
systemctl='/usr/bin/systemctl'

for exe in "$php" "$git" "$install" "$mktemp" "$rm" "$readlink_bin" "$grep_bin" "$stat_bin" "$systemctl" "$host_launcher"; do
  [[ -x "$exe" ]] || { echo "Vereiste executable ontbreekt: $exe" >&2; exit 69; }
done
[[ -d "$platform_root" && -L "$platform_root/current" ]] || { echo 'Actieve immutable platformrelease ontbreekt.' >&2; exit 69; }
[[ -d "$tenant_base" ]] || { echo 'Tenantbasis ontbreekt.' >&2; exit 69; }
[[ -f "$host_launcher" && ! -L "$host_launcher" && "$("$stat_bin" -c '%u:%g:%a' "$host_launcher")" == '0:0:755' ]] || {
  echo 'Root-owned host-launcher ontbreekt of heeft onveilige metadata.' >&2
  exit 69
}

# Een deploy mag pas plaatsvinden nadat alle permanente rootentrypoints uit de
# applicatierelease zijn gemigreerd naar de host-launcher. Zo kan de first-hop
# naar deze securityarchitectuur niet opnieuw via /current als root lopen.
shopt -s nullglob
health_units=(/etc/systemd/system/verenigingsplatform-health-*.service)
[[ "${#health_units[@]}" -gt 0 ]] || {
  echo 'Geen geïnstalleerde tenant-healthservices gevonden.' >&2
  exit 69
}
for unit in "${health_units[@]}"; do
  [[ -f "$unit" && ! -L "$unit" ]] || { echo "Onveilige healthservice: $unit" >&2; exit 69; }
  "$grep_bin" -Fq "ExecStart=$host_launcher health --monitoring-plan=" "$unit" || {
    echo "Healthservice is nog niet naar host-tooling gemigreerd: $unit" >&2
    exit 69
  }
  ! "$grep_bin" -Eq 'ExecStart=.*(/srv/verenigingsplatform/(current|releases)/).*\.php' "$unit" || {
    echo "Healthservice bevat nog root→release PHP: $unit" >&2
    exit 69
  }
done
control_service='verenigingsplatform-control-plane.service'
if "$systemctl" cat "$control_service" --no-pager >/dev/null 2>&1; then
  control_exec="$(SYSTEMD_PAGER=cat "$systemctl" --no-pager show "$control_service" -p ExecStart --value)"
  [[ "$control_exec" == *"$host_launcher control-plane --config=$control_plane_config"* ]] || {
    echo 'Effectieve control-plane service is nog niet naar host-tooling gemigreerd.' >&2
    exit 69
  }
  [[ "$control_exec" != *'/srv/verenigingsplatform/current/'* && "$control_exec" != *'/srv/verenigingsplatform/releases/'* ]] || {
    echo 'Effectieve control-plane service bevat nog root→release code.' >&2
    exit 69
  }
fi
shopt -u nullglob

# De SSH-deploycredential mag uitsluitend de actuele main-tip activeren.
read -r main_commit main_ref < <("$git" ls-remote "$repo" refs/heads/main)
[[ "$main_ref" == 'refs/heads/main' && "$main_commit" =~ ^[0-9a-f]{40}$ ]] || {
  echo 'Actuele main-tip kon niet betrouwbaar uit GitHub worden bepaald.' >&2
  exit 65
}
[[ "$commit" == "$main_commit" ]] || {
  echo 'Deploy geweigerd: gevraagde commit is niet de actuele main-tip.' >&2
  exit 65
}

"$install" -d -m 0700 -o root -g root "$staging_base"
stage="$("$mktemp" -d --tmpdir="$staging_base" "release-${commit:0:12}.XXXXXX")"
source_root="$stage/source"
plan="$stage/release-plan.json"

cleanup() {
  if [[ -n "${stage:-}" && "$stage" == "$staging_base"/release-* && -d "$stage" ]]; then
    "$rm" -rf --one-file-system -- "$stage"
  fi
}
trap cleanup EXIT INT TERM

"$git" clone --quiet --no-checkout --filter=blob:none "$repo" "$source_root"
"$git" -C "$source_root" fetch --quiet --depth=1 origin "$commit"
"$git" -C "$source_root" checkout --quiet --detach "$commit"

actual="$("$git" -C "$source_root" rev-parse HEAD)"
[[ "$actual" == "$commit" ]] || { echo 'Git checkout wijkt af van gevraagde commit.' >&2; exit 65; }
[[ -z "$("$git" -C "$source_root" status --porcelain=v1 --untracked-files=all)" ]] || { echo 'Stagingcheckout is niet schoon.' >&2; exit 65; }

"$host_launcher" release-prepare \
  --source="$source_root" \
  --commit="$commit" \
  --platform-root="$platform_root" \
  --tenant-base="$tenant_base" \
  --output="$plan"

"$host_launcher" release-apply --plan="$plan" --check
"$host_launcher" release-apply --plan="$plan" --deploy

active="$("$readlink_bin" -f "$platform_root/current")"
[[ "$active" == "$platform_root/releases/$commit" ]] || {
  echo "Actieve release wijkt na deploy af: $active" >&2
  exit 70
}

state_commit="$("$php" -r '$p="/srv/verenigingsplatform/release-state.json";$r=@file_get_contents($p);$d=is_string($r)?json_decode($r,true):null;echo is_array($d)?(string)($d["active"]["commit"]??""):"";')"
[[ "$state_commit" == "$commit" ]] || { echo 'release-state.json bevestigt de nieuwe commit niet.' >&2; exit 70; }

# Control-plane refresh loopt uitsluitend via root-owned host-tooling.
if [[ -e "$control_plane_config" || -L "$control_plane_config" ]]; then
  [[ -f "$control_plane_config" && ! -L "$control_plane_config" ]] || {
    echo 'Control-plane runtimeconfig bestaat maar is geen veilig regulier bestand.' >&2
    exit 71
  }
  refresh_output="$("$host_launcher" control-plane --config="$control_plane_config" --refresh-only)"
  printf '%s\n' "$refresh_output"
  grep -Fqx 'REFRESH OK' <<<"$refresh_output" || {
    echo 'Control-plane snapshotrefresh gaf niet de verwachte bevestiging.' >&2
    exit 71
  }
fi

echo "DEPLOYED $commit"
