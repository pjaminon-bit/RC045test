#!/usr/bin/bash
set -euo pipefail
export PATH='/usr/sbin:/usr/bin:/sbin:/bin'

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo 'Deze deploywrapper moet als root draaien.' >&2
  exit 77
fi
if [[ "$#" -ne 0 ]]; then
  echo 'Gebruik: verenigingsplatform-github-deploy < SHA via stdin' >&2
  exit 64
fi

python='/usr/bin/python3'
commit="$("$python" -c 'import re,sys
data=sys.stdin.buffer.read(42)
if len(data) != 41 or re.fullmatch(rb"[0-9a-f]{40}\n", data) is None:
    raise SystemExit(64)
sys.stdout.write(data[:40].decode("ascii"))')" || {
  echo 'Ongeldige deploy-SHA op stdin; exact één lowercase 40-hex regel vereist.' >&2
  exit 64
}

repo='https://github.com/pjaminon-bit/RC045test.git'
platform_root='/srv/verenigingsplatform'
tenant_base='/srv/verenigingen'
staging_base='/var/lib/verenigingsplatform/github-staging'
control_plane_config='/etc/verenigingsplatform/control-plane/runtime.json'
host_launcher='/usr/local/sbin/verenigingsplatform-host-php'
php='/usr/bin/php8.5'
git='/usr/bin/git'
install='/usr/bin/install'
mktemp='/usr/bin/mktemp'
rm='/usr/bin/rm'
readlink_bin='/usr/bin/readlink'
grep_bin='/usr/bin/grep'
stat_bin='/usr/bin/stat'
systemctl='/usr/bin/systemctl'
runuser_bin='/usr/sbin/runuser'
env_bin='/usr/bin/env'
find_bin='/usr/bin/find'
apachectl='/usr/sbin/apache2ctl'

for exe in "$python" "$php" "$git" "$install" "$mktemp" "$rm" "$readlink_bin" "$grep_bin" "$stat_bin" "$systemctl" "$host_launcher" "$runuser_bin" "$env_bin" "$find_bin" "$apachectl"; do
  [[ -x "$exe" ]] || { echo "Vereiste executable ontbreekt: $exe" >&2; exit 69; }
done
[[ -d "$platform_root" && -L "$platform_root/current" ]] || { echo 'Actieve immutable platformrelease ontbreekt.' >&2; exit 69; }
[[ -d "$tenant_base" ]] || { echo 'Tenantbasis ontbreekt.' >&2; exit 69; }
[[ -f "$host_launcher" && ! -L "$host_launcher" && "$("$stat_bin" -c '%u:%g:%a' "$host_launcher")" == '0:0:755' ]] || {
  echo 'Root-owned host-launcher ontbreekt of heeft onveilige metadata.' >&2
  exit 69
}

validate_already_active() {
  local active checker row tenant runtime_user php_version config private php_bin syntax_user tenant_inventory
  local tenant_count=0
  local -a tenant_rows=()
  declare -A php_bins=()
  declare -A php_users=()

  active="$("$readlink_bin" -f "$platform_root/current")"
  [[ "$active" == "$platform_root/releases/$commit" && -d "$active" && ! -L "$active" ]] || {
    echo 'Same-active validatie geweigerd: current wijst niet exact naar de gevraagde immutable main-release.' >&2
    return 1
  }

  checker="$active/bin/check-release-tenant.php"
  [[ -f "$checker" && ! -L "$checker" && -r "$checker" ]] || {
    echo 'Same-active validatie geweigerd: tenantprobe ontbreekt in actieve release.' >&2
    return 1
  }

  if ! tenant_inventory="$("$python" - "$tenant_base" <<'PY'
import json
import re
import sys
from pathlib import Path

base = Path(sys.argv[1])
if not base.is_dir() or base.is_symlink():
    raise SystemExit(2)

rows = []
for tenant_dir in sorted(base.iterdir(), key=lambda p: p.name):
    if tenant_dir.is_symlink() or not tenant_dir.is_dir():
        raise SystemExit(3)
    tenant = tenant_dir.name
    if re.fullmatch(r'[a-z0-9]([a-z0-9-]*[a-z0-9])?', tenant) is None:
        raise SystemExit(4)
    runtime = tenant_dir / 'runtime' / 'runtime-plan.json'
    config = tenant_dir / 'config.php'
    private = tenant_dir / 'private'
    if runtime.is_symlink() or not runtime.is_file() or config.is_symlink() or not config.is_file() or private.is_symlink() or not private.is_dir():
        raise SystemExit(5)
    try:
        doc = json.loads(runtime.read_text(encoding='utf-8'))
    except (OSError, UnicodeError, ValueError):
        raise SystemExit(6)
    if not isinstance(doc, dict) or doc.get('tenant_key') != tenant:
        raise SystemExit(7)
    os_doc = doc.get('os')
    settings = doc.get('settings')
    if not isinstance(os_doc, dict) or not isinstance(settings, dict):
        raise SystemExit(8)
    user = os_doc.get('user')
    php_version = settings.get('php_version')
    if not isinstance(user, str) or re.fullmatch(r'vst[0-9a-f]{16}', user) is None:
        raise SystemExit(9)
    if not isinstance(php_version, str) or re.fullmatch(r'[0-9]+\.[0-9]+', php_version) is None:
        raise SystemExit(10)
    values = [tenant, user, php_version, str(config), str(private)]
    if any('\t' in value or '\n' in value for value in values):
        raise SystemExit(11)
    rows.append('\t'.join(values))

if not rows:
    raise SystemExit(12)
print('\n'.join(rows))
PY
  )"; then
    echo 'Same-active validatie geweigerd: tenantinventaris kon niet veilig worden opgebouwd.' >&2
    return 1
  fi
  mapfile -t tenant_rows <<<"$tenant_inventory"

  [[ "${#tenant_rows[@]}" -gt 0 ]] || {
    echo 'Same-active validatie geweigerd: geen tenants gevonden.' >&2
    return 1
  }

  for row in "${tenant_rows[@]}"; do
    IFS=$'\t' read -r tenant runtime_user php_version config private <<<"$row"
    [[ -n "$tenant" && -n "$runtime_user" && -n "$php_version" && -n "$config" && -n "$private" ]] || {
      echo 'Same-active validatie geweigerd: onvolledige tenantregel.' >&2
      return 1
    }
    /usr/bin/id "$runtime_user" >/dev/null 2>&1 || {
      echo "Same-active validatie geweigerd: runtime-user ontbreekt voor $tenant." >&2
      return 1
    }
    php_bin="/usr/bin/php$php_version"
    [[ -x "$php_bin" ]] || {
      echo "Same-active validatie geweigerd: PHP CLI ontbreekt voor $tenant." >&2
      return 1
    }
    php_bins["$php_bin"]=1
    if [[ -z "${php_users[$php_bin]:-}" ]]; then
      php_users["$php_bin"]="$runtime_user"
    fi

    "$runuser_bin" -u "$runtime_user" -- "$env_bin" \
      VERENIGING_REQUIRE_TENANT_CONFIG=1 \
      "VERENIGING_CONFIG_FILE=$config" \
      "VERENIGING_PRIVATE_ROOT=$private" \
      PATH=/usr/sbin:/usr/bin:/sbin:/bin \
      "$php_bin" "$checker" "--expected-tenant=$tenant" >/dev/null || {
        echo "Same-active validatie geweigerd: tenantprobe faalt voor $tenant." >&2
        return 1
      }
    tenant_count=$((tenant_count + 1))
  done

  for php_bin in "${!php_bins[@]}"; do
    syntax_user="${php_users[$php_bin]:-}"
    [[ -n "$syntax_user" ]] || {
      echo "Same-active validatie geweigerd: geen tenant-user gebonden aan $php_bin." >&2
      return 1
    }
    while IFS= read -r -d '' php_file; do
      "$runuser_bin" -u "$syntax_user" -- "$php_bin" -l "$php_file" >/dev/null || {
        echo "Same-active validatie geweigerd: PHP syntax faalt in $php_file onder $php_bin." >&2
        return 1
      }
    done < <("$find_bin" "$active" -type f -name '*.php' -print0)
  done

  "$apachectl" configtest >/dev/null || {
    echo 'Same-active validatie geweigerd: Apache configtest faalt.' >&2
    return 1
  }

  echo "DEPLOY NOOP VALIDATED commit=$commit tenants=$tenant_count already_active=1"
}

# Een deploy mag pas plaatsvinden nadat alle permanente rootentrypoints uit de
# applicatierelease zijn gemigreerd naar de host-launcher. Zo kan de first-hop
# naar deze securityarchitectuur niet opnieuw via /current als root lopen.
shopt -s nullglob
health_units=(/etc/systemd/system/verenigingsplatform-health-*.service)
[[ "${#health_units[@]}" -gt 0 ]] || {
  echo 'Geen geïnstalleerde tenant-healthservices gevonden.' >&2
  exit 69
}
for unit in "${health_units[@]}"; do
  [[ -f "$unit" && ! -L "$unit" ]] || { echo "Onveilige healthservice: $unit" >&2; exit 69; }
  "$grep_bin" -Fq "ExecStart=$host_launcher health --monitoring-plan=" "$unit" || {
    echo "Healthservice is nog niet naar host-tooling gemigreerd: $unit" >&2
    exit 69
  }
  ! "$grep_bin" -Eq 'ExecStart=.*(/srv/verenigingsplatform/(current|releases)/).*\.php' "$unit" || {
    echo "Healthservice bevat nog root→release PHP: $unit" >&2
    exit 69
  }
done
control_service='verenigingsplatform-control-plane.service'
if "$systemctl" cat "$control_service" --no-pager >/dev/null 2>&1; then
  control_exec="$(SYSTEMD_PAGER=cat "$systemctl" --no-pager show "$control_service" -p ExecStart --value)"
  [[ "$control_exec" == *"$host_launcher control-plane --config=$control_plane_config"* ]] || {
    echo 'Effectieve control-plane service is nog niet naar host-tooling gemigreerd.' >&2
    exit 69
  }
  [[ "$control_exec" != *'/srv/verenigingsplatform/current/'* && "$control_exec" != *'/srv/verenigingsplatform/releases/'* ]] || {
    echo 'Effectieve control-plane service bevat nog root→release code.' >&2
    exit 69
  }
fi
shopt -u nullglob

# De SSH-deploycredential mag uitsluitend de actuele main-tip activeren.
read -r main_commit main_ref < <("$git" ls-remote "$repo" refs/heads/main)
[[ "$main_ref" == 'refs/heads/main' && "$main_commit" =~ ^[0-9a-f]{40}$ ]] || {
  echo 'Actuele main-tip kon niet betrouwbaar uit GitHub worden bepaald.' >&2
  exit 65
}
[[ "$commit" == "$main_commit" ]] || {
  echo 'Deploy geweigerd: gevraagde commit is niet de actuele main-tip.' >&2
  exit 65
}

"$install" -d -m 0700 -o root -g root "$staging_base"
stage="$("$mktemp" -d --tmpdir="$staging_base" "release-${commit:0:12}.XXXXXX")"
source_root="$stage/source"
plan="$stage/release-plan.json"

cleanup() {
  if [[ -n "${stage:-}" && "$stage" == "$staging_base"/release-* && -d "$stage" ]]; then
    "$rm" -rf --one-file-system -- "$stage"
  fi
}
trap cleanup EXIT INT TERM

"$git" clone --quiet --no-checkout --filter=blob:none "$repo" "$source_root"
"$git" -C "$source_root" fetch --quiet --depth=1 origin "$commit"
"$git" -C "$source_root" checkout --quiet --detach "$commit"

actual="$("$git" -C "$source_root" rev-parse HEAD)"
[[ "$actual" == "$commit" ]] || { echo 'Git checkout wijkt af van gevraagde commit.' >&2; exit 65; }
[[ -z "$("$git" -C "$source_root" status --porcelain=v1 --untracked-files=all)" ]] || { echo 'Stagingcheckout is niet schoon.' >&2; exit 65; }

"$host_launcher" release-prepare \
  --source="$source_root" \
  --commit="$commit" \
  --platform-root="$platform_root" \
  --tenant-base="$tenant_base" \
  --output="$plan"

"$host_launcher" release-apply --plan="$plan" --check

set +e
deploy_output="$("$host_launcher" release-apply --plan="$plan" --deploy 2>&1)"
deploy_rc=$?
set -e
if [[ "$deploy_rc" -eq 0 ]]; then
  printf '%s\n' "$deploy_output"
elif [[ "$deploy_rc" -eq 1 && "$deploy_output" == 'FOUT: Kandidaatrelease is al actief.' ]]; then
  validate_already_active
else
  [[ -z "$deploy_output" ]] || printf '%s\n' "$deploy_output" >&2
  exit "$deploy_rc"
fi

active="$("$readlink_bin" -f "$platform_root/current")"
[[ "$active" == "$platform_root/releases/$commit" ]] || {
  echo "Actieve release wijkt na deploy af: $active" >&2
  exit 70
}

state_commit="$("$php" -r '$p="/srv/verenigingsplatform/release-state.json";$r=@file_get_contents($p);$d=is_string($r)?json_decode($r,true):null;echo is_array($d)?(string)($d["active"]["commit"]??""):"";')"
[[ "$state_commit" == "$commit" ]] || { echo 'release-state.json bevestigt de nieuwe commit niet.' >&2; exit 70; }

# Control-plane refresh loopt uitsluitend via root-owned host-tooling.
if [[ -e "$control_plane_config" || -L "$control_plane_config" ]]; then
  [[ -f "$control_plane_config" && ! -L "$control_plane_config" ]] || {
    echo 'Control-plane runtimeconfig bestaat maar is geen veilig regulier bestand.' >&2
    exit 71
  }
  refresh_output="$("$host_launcher" control-plane --config="$control_plane_config" --refresh-only)"
  printf '%s\n' "$refresh_output"
  grep -Fqx 'REFRESH OK' <<<"$refresh_output" || {
    echo 'Control-plane snapshotrefresh gaf niet de verwachte bevestiging.' >&2
    exit 71
  }
fi

echo "DEPLOYED $commit"
