#!/usr/bin/env bash
set -euo pipefail

origineel="${SSH_ORIGINAL_COMMAND:-}"
if [[ ! "$origineel" =~ ^deploy[[:space:]]+([0-9a-f]{40})$ ]]; then
  echo 'Alleen deploy <40-hex-commit> is toegestaan.' >&2
  exit 64
fi

commit="${BASH_REMATCH[1]}"
exec /usr/bin/sudo -n /usr/local/sbin/verenigingsplatform-github-deploy "$commit"
