#!/usr/bin/bash
set -Eeuo pipefail
export PATH='/usr/sbin:/usr/bin:/sbin:/bin'
umask 077

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  echo 'Public-root cutover moet als root draaien.' >&2
  exit 77
fi
if [[ "$#" -ne 2 || ! "$1" =~ ^[0-9a-f]{40}$ || ! "$2" =~ ^/ ]]; then
  echo 'Gebruik: finalize-public-root-cutover <40-hex-main-commit> <absolute-schone-checkout>' >&2
  exit 64
fi

TARGET="$1"
REPO="${2%/}"
TENANT='test'
TENANT_ROOT="/srv/verenigingen/$TENANT"
HOSTNAME='test.vps.holox.nl'
PUBLIC_IPV4='149.143.36.59'
RESOLVER='doh:cloudflare'
DOH_ENDPOINT='cloudflare-dns.com'
PHP='/usr/bin/php8.5'
RUNUSER='/usr/sbin/runuser'
HOST_LAUNCHER='/usr/local/sbin/verenigingsplatform-host-php'
HOST_CONFIG='/etc/verenigingsplatform/host-engine.path'
RUNTIME_PLAN="$TENANT_ROOT/runtime/runtime-plan.json"
WEB_DIR="$TENANT_ROOT/webserver-226"
WEB_PLAN="$WEB_DIR/web-plan.json"
DNS_PLAN="$TENANT_ROOT/dns/dns-plan.json"
DNS_READY="$TENANT_ROOT/dns/dns-readiness.json"
TLS_PLAN="$TENANT_ROOT/tls/tls-plan.json"
DB_PLAN="$TENANT_ROOT/database/database-plan.json"
MON_PLAN="$TENANT_ROOT/monitoring/monitoring-plan.json"
LIFE_PLAN="$TENANT_ROOT/lifecycle/lifecycle-plan.json"
TMP_WEB=''
TMP_DNS=''
CUTOVER_STARTED=0
CUTOVER_COMMITTED=0
LIVE_FRAGMENT=''
BACKUP_FRAGMENT=''
BACKUP_DIR=''
FAILURE_PATH=''
FAILURE_EXPECTED=''
FAILURE_OBSERVED=''

log() { printf '\n=== %s ===\n' "$*"; }
die() { echo "FOUT #226: $*" >&2; exit 1; }

capture_failure_diagnostics() {
  [[ -n "$BACKUP_DIR" && -d "$BACKUP_DIR" ]] || return 0
  set +e
  local report="$BACKUP_DIR/failure-diagnostics.txt"
  local php_version='' pool='' pool_file='' active_release='unresolved'
  php_version="$(/usr/bin/jq -er '.settings.php_version // empty' "$RUNTIME_PLAN" 2>/dev/null)"
  pool="$(/usr/bin/jq -er '.php_fpm.pool // empty' "$RUNTIME_PLAN" 2>/dev/null)"
  active_release="$(/usr/bin/readlink -f /srv/verenigingsplatform/current 2>/dev/null)"

  {
    echo "captured_at_utc=$(/usr/bin/date -u '+%Y-%m-%dT%H:%M:%SZ')"
    echo "target_main=$TARGET"
    echo "active_release=${active_release:-unresolved}"
    echo "failure_path=${FAILURE_PATH:-unknown}"
    echo "failure_expected_http=${FAILURE_EXPECTED:-unknown}"
    echo "failure_observed_http=${FAILURE_OBSERVED:-unknown}"
    if [[ -f "$ROUTING_SRC" && ! -L "$ROUTING_SRC" ]]; then
      echo "candidate_fragment_sha256=$(/usr/bin/sha256sum "$ROUTING_SRC" | /usr/bin/awk '{print $1}')"
    fi
    if [[ -f "$LIVE_FRAGMENT" && ! -L "$LIVE_FRAGMENT" ]]; then
      echo "active_fragment_sha256=$(/usr/bin/sha256sum "$LIVE_FRAGMENT" | /usr/bin/awk '{print $1}')"
    fi
    if [[ -f "$RUNTIME_PLAN" && ! -L "$RUNTIME_PLAN" ]]; then
      echo "runtime_plan_sha256=$(/usr/bin/sha256sum "$RUNTIME_PLAN" | /usr/bin/awk '{print $1}')"
    fi
    if [[ "$php_version" =~ ^[0-9]{1,2}\.[0-9]{1,2}$ && "$pool" =~ ^[a-z0-9_-]{1,80}$ ]]; then
      pool_file="/etc/php/$php_version/fpm/pool.d/$pool.conf"
      echo "php_version=$php_version"
      echo "php_fpm_pool=$pool"
      echo "php_fpm_pool_file=$pool_file"
      if [[ -f "$pool_file" && ! -L "$pool_file" ]]; then
        echo "php_fpm_pool_sha256=$(/usr/bin/sha256sum "$pool_file" | /usr/bin/awk '{print $1}')"
      else
        echo 'php_fpm_pool_sha256=unavailable'
      fi
    else
      echo 'php_fpm_pool=unresolved'
    fi
    /usr/bin/systemctl is-active apache2 2>/dev/null | /usr/bin/awk '{print "apache_state=" $0}'
  } > "$report" 2>&1

  /usr/sbin/apache2ctl configtest > "$BACKUP_DIR/apache-configtest.txt" 2>&1
  /usr/bin/grep -E 'proxy_fcgi|AH010|PHP Fatal|Fatal error|Uncaught|Permission denied|Primary script|open_basedir' \
    /var/log/apache2/error.log 2>/dev/null | /usr/bin/tail -n 200 > "$BACKUP_DIR/apache-error.filtered.log"
  if [[ "$php_version" =~ ^[0-9]{1,2}\.[0-9]{1,2}$ ]]; then
    /usr/bin/grep -E "${pool:-vst-test}|PHP Fatal error|Fatal error|Uncaught|Permission denied|Primary script|open_basedir|ERROR|WARNING" \
      "/var/log/php${php_version}-fpm.log" 2>/dev/null | /usr/bin/tail -n 200 > "$BACKUP_DIR/php-fpm.filtered.log"
  fi
  for evidence in "$report" "$BACKUP_DIR/apache-configtest.txt" "$BACKUP_DIR/apache-error.filtered.log" "$BACKUP_DIR/php-fpm.filtered.log"; do
    [[ -f "$evidence" ]] && /usr/bin/chmod 0600 "$evidence"
  done
  echo "FAILURE_DIAGNOSTICS=$BACKUP_DIR" >&2
  set -e
  return 0
}

preserve_http_failure() {
  local probe_body="$1" probe_stderr="$2"
  if [[ -f "$probe_body" ]]; then
    /usr/bin/head -c 65536 "$probe_body" > "$BACKUP_DIR/http-failure.body" 2>/dev/null || true
    /usr/bin/chmod 0600 "$BACKUP_DIR/http-failure.body" 2>/dev/null || true
  fi
  if [[ -f "$probe_stderr" ]]; then
    /usr/bin/head -c 16384 "$probe_stderr" > "$BACKUP_DIR/http-failure.curl-stderr" 2>/dev/null || true
    /usr/bin/chmod 0600 "$BACKUP_DIR/http-failure.curl-stderr" 2>/dev/null || true
  fi
  /usr/bin/rm -f "$probe_body" "$probe_stderr"
}

rollback_fragment() {
  set +e
  echo 'ROLLBACK: herstel oorspronkelijk Apache-routingfragment.' >&2
  if [[ -n "$LIVE_FRAGMENT" && -n "$BACKUP_FRAGMENT" && -f "$BACKUP_FRAGMENT" && ! -L "$LIVE_FRAGMENT" ]]; then
    local tmp="${LIVE_FRAGMENT}.rollback.$$"
    /usr/bin/install -o root -g root -m 0644 "$BACKUP_FRAGMENT" "$tmp" && \
      /usr/bin/mv -f "$tmp" "$LIVE_FRAGMENT" && \
      /usr/sbin/apache2ctl configtest && \
      /usr/bin/systemctl reload apache2
    local rc=$?
    [[ -e "$tmp" ]] && /usr/bin/rm -f "$tmp"
    if [[ $rc -eq 0 ]]; then
      echo 'ROLLBACK OK: oorspronkelijke routing actief.' >&2
    else
      echo 'KRITIEK: automatische rollback kon niet volledig worden bevestigd.' >&2
    fi
  fi
  set -e
}

cleanup() {
  local rc=$?
  trap - EXIT
  [[ -n "$TMP_WEB" && -f "$TMP_WEB" ]] && /usr/bin/rm -f "$TMP_WEB"
  [[ -n "$TMP_DNS" && -f "$TMP_DNS" ]] && /usr/bin/rm -f "$TMP_DNS"
  if [[ $rc -ne 0 && $CUTOVER_STARTED -eq 1 && $CUTOVER_COMMITTED -eq 0 ]]; then
    capture_failure_diagnostics
    rollback_fragment
  fi
  exit "$rc"
}
trap cleanup EXIT

for exe in /usr/bin/bash /usr/bin/git /usr/bin/jq /usr/bin/curl /usr/bin/sha256sum \
  /usr/bin/cmp /usr/bin/install /usr/bin/mv /usr/bin/cp /usr/bin/mktemp \
  /usr/bin/stat /usr/bin/readlink /usr/bin/grep /usr/bin/awk /usr/bin/chown \
  /usr/bin/chmod /usr/bin/rm /usr/bin/head /usr/bin/tail /usr/bin/date /usr/bin/env \
  /usr/sbin/apache2ctl /usr/bin/systemctl "$PHP" "$RUNUSER"; do
  [[ -x "$exe" ]] || die "vereiste executable ontbreekt: $exe"
done

log '1/8 broncheckout en trusted host-engine'
[[ -d "$REPO" && ! -L "$REPO" ]] || die 'stagingcheckout ontbreekt of is een symlink.'
[[ "$(cd "$REPO" && pwd -P)" == "$REPO" ]] || die 'stagingcheckout is niet het canonieke fysieke pad.'
[[ "$(/usr/bin/git -C "$REPO" rev-parse HEAD)" == "$TARGET" ]] || die 'stagingcheckout staat niet op de opgegeven main-commit.'
[[ -z "$(/usr/bin/git -C "$REPO" status --porcelain=v1 --untracked-files=all)" ]] || die 'stagingcheckout is niet schoon.'
REMOTE_MAIN="$(/usr/bin/git -C "$REPO" ls-remote origin refs/heads/main | /usr/bin/awk 'NR==1 {print $1}')"
[[ "$REMOTE_MAIN" == "$TARGET" ]] || die 'opgegeven commit is niet de actuele remote main-tip.'
/usr/bin/bash "$REPO/ops/vps-test-deploy/install-verenigingsplatform-host-engine" "$TARGET" "$REPO"
[[ -f "$HOST_CONFIG" && ! -L "$HOST_CONFIG" ]] || die 'host-engine configuratie ontbreekt of is onveilig.'
IFS= read -r ENGINE < "$HOST_CONFIG"
[[ "$ENGINE" == "/usr/local/libexec/verenigingsplatform/host-engine/$TARGET" && -d "$ENGINE" && ! -L "$ENGINE" ]] || die 'actieve host-engine is niet exact de opgegeven commit.'
(
  cd "$ENGINE"
  /usr/bin/sha256sum --check --quiet .host-engine-manifest.sha256
) || die 'host-engine manifestvalidatie faalt.'

log '2/8 #226 webserverkandidaat deterministisch regenereren en valideren'
[[ -f "$RUNTIME_PLAN" && ! -L "$RUNTIME_PLAN" ]] || die 'runtime-plan ontbreekt of is onveilig.'
TMP_WEB="$(/usr/bin/mktemp /tmp/rc045-226-web.XXXXXX.json)"
"$PHP" "$ENGINE/bin/prepare-vps-webserver.php" \
  --runtime-plan="$RUNTIME_PLAN" \
  --output-dir="$WEB_DIR" \
  --dry-run > "$TMP_WEB"
